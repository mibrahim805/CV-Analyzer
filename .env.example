# Development only. Replace every secret outside local development.
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://career:career@localhost:55432/career
DATABASE_URL_SYNC=postgresql+psycopg://career:career@localhost:55432/career
REDIS_URL=redis://localhost:56379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
WEB_ORIGIN=http://localhost:3000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OBJECT_STORAGE_ENDPOINT=http://localhost:9090
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9090
OBJECT_STORAGE_ACCESS_KEY=career-local
OBJECT_STORAGE_SECRET_KEY=replace-local-storage-secret
OBJECT_STORAGE_BUCKET_QUARANTINE=career-quarantine
OBJECT_STORAGE_BUCKET_DOCUMENTS=career-documents
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MAX_CV_BYTES=10485760
# Optional approved public job feeds. Use comma-separated board/site identifiers;
# leave empty to keep the UI explicit about provider availability.
GREENHOUSE_BOARD_TOKENS=
LEVER_SITE_NAMES=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
